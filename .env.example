# ─────────────────────────────────────────────────────────────
# SchoolCo Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ─────────────────────────────────────────────────────────────

# ── Supabase (required) ───────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── App URL (required for auth callbacks) ─────────────────────
# Development:  http://localhost:3000
# Staging:      https://staging.schoolco.app
# Production:   https://schoolco.app  (or your custom domain)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Default Organization ──────────────────────────────────────
# The slug of the first / primary organization on this instance.
# Used for default redirects and onboarding. NOT hard-coded.
NEXT_PUBLIC_DEFAULT_ORGANIZATION_SLUG=rising-leaders-academy

# ── Supabase Service Role Key ─────────────────────────────────
# IMPORTANT: This key bypasses all RLS policies.
# - NEVER prefix with NEXT_PUBLIC_
# - NEVER import into client components or browser-side code
# - ONLY use in Server Actions, Route Handlers, or server utilities
# - Treat it like a database root password
# Found in: Supabase Dashboard → Project Settings → API → Service Role Key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Google Drive (required for student folder provisioning) ──────
# IMPORTANT: Service account credentials — NEVER prefix with NEXT_PUBLIC_
# NEVER import into client components — ONLY use in Server Actions and server utilities
#
# Setup:
#   1. Google Cloud Console → Create project → Enable Drive API
#   2. IAM & Admin → Service Accounts → Create → Download JSON key
#   3. Paste the entire JSON as the value of GOOGLE_SERVICE_ACCOUNT_JSON
#   4. Create root Drive folder: "Rising Leaders Academy — Student Records"
#   5. Share it with the service account email (Editor permission)
#   6. Copy the folder ID from the URL → GOOGLE_DRIVE_ROOT_FOLDER_ID
#
# Student folders will be created inside GOOGLE_DRIVE_ROOT_FOLDER_ID.
# Folders are private (service-account only). Staff access is via Google Workspace sharing.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
GOOGLE_DRIVE_ROOT_FOLDER_ID=your-root-folder-id-here

# ── Supabase CLI (for migrations only) ───────────────────────────
# - NEVER print or log this value
# - Only needed locally to run: npx supabase db push --linked
# Found in: app.supabase.com → Account → Access Tokens
# SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxxxxxx

# ── Resend (Sprint 2 — do not add until Sprint 2 begins) ──────
# Transactional email provider for guardian notifications,
# announcements, and incident alerts.
# - NEVER prefix with NEXT_PUBLIC_
# - ONLY use in Server Actions or Route Handlers
# Found in: resend.com → API Keys → Create API Key
# See: RESEND_SETUP.md for full setup instructions
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
